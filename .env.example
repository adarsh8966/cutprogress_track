# CUT OS environment
#
# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API

# Safe to expose to the browser. Row-level security is what actually protects
# your data, and it is keyed to the signed-in user.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Where Supabase should send the email-confirmation link back to.
# Set this in any deployment behind a proxy, where the request headers are not
# a reliable guide to the public URL. Whatever you use must also be listed
# under Authentication -> URL Configuration -> Redirect URLs in Supabase.
# NEXT_PUBLIC_SITE_URL=https://cut-os.example.com

# SERVER ONLY. NEVER prefix this with NEXT_PUBLIC_ - anything so prefixed is
# inlined into the browser bundle by Next.js, and this key bypasses every RLS
# policy. The application does not currently need it; it is listed here only so
# that a future Edge Function has a documented home for it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
