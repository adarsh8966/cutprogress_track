# CUT OS environment
#
# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API

# Safe to expose to the browser. Row-level security is what actually protects
# your data, and it is keyed to the signed-in user.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Where Supabase should send the email-confirmation link back to.
# Set this in any deployment behind a proxy, where the request headers are not
# a reliable guide to the public URL. Whatever you use must also be listed
# under Authentication -> URL Configuration -> Redirect URLs in Supabase.
# NEXT_PUBLIC_SITE_URL=https://cut-os.example.com

# ---------------------------------------------------------------------------
# HEVY (training)
# ---------------------------------------------------------------------------
# SERVER ONLY, and required for any Hevy sync. Get it from
# https://hevy.com/settings?developer - the API is a Hevy Pro feature.
#
# NEVER prefix this with NEXT_PUBLIC_: anything so prefixed is inlined into the
# browser bundle by Next.js. It is read only by lib/integrations/hevy/env.ts,
# which is server-only, and it is never stored in the database.
HEVY_API_KEY=your-hevy-api-key

# Optional. The API host is not stated in Hevy's published documentation, which
# gives paths and no origin, so the default was inferred rather than read. If
# "Test connection" on /import fails to reach Hevy at all, set this.
# HEVY_API_BASE_URL=https://api.hevyapp.com

# SERVER ONLY. NEVER prefix this with NEXT_PUBLIC_ - anything so prefixed is
# inlined into the browser bundle by Next.js, and this key bypasses every RLS
# policy. The application does not currently need it: syncing is a button the
# signed-in user presses, so every path runs under the policies with the anon
# key. It is listed here only so that a future Edge Function has a documented
# home for it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# GOOGLE HEALTH (activity, recovery, sleep, body composition)
# ---------------------------------------------------------------------------
# The successor to the Fitbit Web API, which shuts down in September 2026.
# All three are SERVER ONLY and none may be prefixed NEXT_PUBLIC_: anything so
# prefixed is inlined into the browser bundle by Next.js.
#
# From Google Cloud -> APIs & Services -> Credentials -> your Web application
# OAuth client. See docs/google-health.md for the full setup, including the
# exact redirect URI to register.
GOOGLE_HEALTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_HEALTH_CLIENT_SECRET=your-client-secret

# Encrypts the OAuth refresh token before it is stored (AES-256-GCM).
#
# WHY THIS EXISTS. Hevy needed one static API key, so "no third-party
# credential is stored in the database" cost nothing. An OAuth refresh token
# cannot work that way: it is issued per user at consent time and is revocable
# by that user. So it is stored - encrypted, with the key here and never in the
# database, so a copy of the database is not a way into anyone's Google account.
#
# Generate one with:  openssl rand -base64 32
#
# CHANGING IT INVALIDATES EVERY STORED CREDENTIAL. Nothing is lost - no
# measurement is encrypted with it - but you will have to reconnect Google
# Health. The app says so plainly rather than failing mysteriously.
GOOGLE_HEALTH_TOKEN_KEY=your-32-byte-base64-key

# Optional. Where Google sends the user back to after consent. It must match an
# Authorized redirect URI in the Google Cloud OAuth client CHARACTER FOR
# CHARACTER, or Google refuses the flow with an error the user cannot act on.
#
# Derived from NEXT_PUBLIC_SITE_URL when unset, and from http://localhost:3000
# when that is unset too. Set it explicitly in any deployment behind a proxy,
# where request headers are not a reliable guide to the public URL.
#   local:       http://localhost:3000/auth/google-health/callback
#   production:  https://your-domain/auth/google-health/callback
# GOOGLE_HEALTH_REDIRECT_URI=https://cut-os.example.com/auth/google-health/callback

# Optional. The documented API host, overridable only for testing.
# GOOGLE_HEALTH_API_BASE_URL=https://health.googleapis.com
